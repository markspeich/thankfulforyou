{
  "name": "thankfulforyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build_static.mjs",
    "setup:worktree": "node tools/setup_worktree_env.mjs",
    "prepare:local": "node tools/prepare_local_env.mjs",
    "initialize:local": "node tools/run_with_supabase_env.mjs --env local -- node tools/initialize_app.mjs",
    "db:local:orders:count": "node tools/db_admin/order_data.mjs orders:count --target=local",
    "db:local:orders:purge": "node tools/db_admin/order_data.mjs orders:purge --target=local",
    "db:prod:orders:count": "node tools/db_admin/order_data.mjs orders:count --target=production",
    "db:prod:orders:purge": "node tools/db_admin/order_data.mjs orders:purge --target=production",
    "db:etsy:attempts": "node tools/db_admin/etsy_import_attempts.mjs",
    "db:prod:migrations:check": "node tools/check_migration_drift.mjs",
    "supabase:start:local": "node tools/supabase_start_local.mjs",
    "supabase:status:local": "node tools/supabase_status_local.mjs",
    "supabase:stop:local": "node tools/supabase_stop_local.mjs",
    "start": "node tools/run_with_supabase_env.mjs --env local -- node --watch tools/dev_server.mjs",
    "start:local": "node tools/run_with_supabase_env.mjs --env local -- node --watch tools/dev_server.mjs",
    "start:remote": "node tools/run_with_supabase_env.mjs --env remote -- node --watch tools/dev_server.mjs",
    "stop:local": "node tools/stop_dev_server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:db": "node tools/run_db_tests.mjs",
    "test:db:local": "node tools/run_db_tests.mjs --env local",
    "test:db:remote": "node tools/run_db_tests.mjs --env remote",
    "test:e2e": "node tools/run_playwright.mjs",
    "test:e2e:raw": "playwright test",
    "test:e2e:preview": "node tools/run_playwright.mjs preview"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/functions": "^3.7.6",
    "a11y-dialog": "^8.1.5",
    "yauzl": "^3.4.0"
  }
}
