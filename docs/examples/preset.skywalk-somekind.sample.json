{
  "$schema": "../schemas/preset.schema.json",
  "schemaVersion": 1,
  "id": "skywalk-somekind",
  "name": "Skywalk, Somekind",
  "description": "Use Skywalk on the first line and Somekind on the remaining lines.",
  "globalDefaults": {
    "backingMm": 3.1,
    "weldExportedDesign": true
  },
  "lineDefaults": {
    "fontId": "candlepin",
    "bridgeMm": 0.5,
    "lineBridgeMm": 0.5,
    "offsetXMm": 0,
    "fontSizeMm": 34
  },
  "lineRules": [
    {
      "match": {
        "kind": "first"
      },
      "settings": {
        "fontId": "skywalk"
      }
    },
    {
      "match": {
        "kind": "remaining"
      },
      "settings": {
        "fontId": "somekind"
      }
    }
  ],
  "listingAssignments": [
    {
      "listingId": "1884223710",
      "name": "Skywalk + Somekind listing with shorter second line",
      "lineOverrides": [
        {
          "lineIndex": 1,
          "settings": {
            "fontSizeMm": 21
          }
        }
      ]
    }
  ]
}
