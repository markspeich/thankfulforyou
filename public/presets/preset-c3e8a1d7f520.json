{
  "$schema": "../../docs/schemas/preset.schema.json",
  "schemaVersion": 1,
  "id": "preset-c3e8a1d7f520",
  "name": "Skywalk, Somekind",
  "description": "Use Skywalk on the first line and Somekind on the remaining lines.",
  "globalDefaults": {
    "boundingSizePresetId": "size-2-2x1-5",
    "backingMm": 3.1,
    "weldExportedDesign": true
  },
  "lineDefaults": {
    "fontId": "candlepin",
    "bridgeMm": 0.5,
    "lineBridgeMm": 0.5,
    "offsetXMm": 0,
    "fontSizeMm": 34,
    "horizontalScale": 1,
    "verticalScale": 1,
    "lockTextHeight": false
  },
  "lineRules": [
    {
      "match": {
        "kind": "first"
      },
      "settings": {
        "fontId": "skywalk",
        "fontSizeMm": 18
      }
    },
    {
      "match": {
        "kind": "remaining"
      },
      "settings": {
        "fontId": "somekind"
      }
    },
    {
      "match": {
        "kind": "index",
        "lineIndex": 1
      },
      "settings": {
        "fontSizeMm": 23,
        "lockTextHeight": true
      }
    }
  ],
  "listingAssignments": [
    {
      "listingId": "1884223710",
      "name": "Skywalk + Somekind listing with shorter second line",
      "lineOverrides": [
        {
          "lineIndex": 1,
          "settings": {
            "fontSizeMm": 23
          }
        }
      ]
    }
  ]
}
