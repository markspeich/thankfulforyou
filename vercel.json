{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/export-svg",
      "destination": "/api/export_svg"
    },
    {
      "source": "/api/layout-analyze",
      "destination": "/api/layout_analyze"
    },
    {
      "source": "/(orders|production-batch|presets|fonts|fixed-designs|size-guides)(/.*)?",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/amazon-import.js": {
      "supportsCancellation": true
    },
    "api/**/*.py": {
      "includeFiles": "public/fonts/**/*",
      "maxDuration": 60,
      "excludeFiles": "{docs/**,tests/**,test-results/**,playwright-report/**,coverage/**,node_modules/**,dist/**,*.log}"
    }
  }
}
